# Copia este archivo como .env para desarrollo local.
# El valor debe incluir el prefijo /api y NO llevar barra al final.
# En el APK esta URL se compila como valor inicial; luego se puede cambiar
# desde el boton "Servidor" dentro de la app.
VITE_API_URL=http://localhost:5000/api
# Numero de WhatsApp de la clinica para pruebas (sin + ni espacios).
VITE_WHATSAPP_NUMBER=50500000000
